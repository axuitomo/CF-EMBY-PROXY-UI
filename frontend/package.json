{
  "name": "cf-emby-proxy-ui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "sync:admin-runtime": "node ./scripts/sync-admin-runtime.mjs",
    "check:admin-runtime": "node ./scripts/sync-admin-runtime.mjs --check",
    "dev": "node ./scripts/sync-admin-runtime.mjs && node ./scripts/dev-server.mjs",
    "build": "node ./scripts/sync-admin-runtime.mjs && node ./scripts/build-admin-vendor.mjs && node ./scripts/publish-dist.mjs",
    "build:cdn": "node ./scripts/sync-admin-runtime.mjs && node ./scripts/build-admin-vendor.mjs && node ./scripts/publish-dist.mjs && node ./scripts/check-cdn-paths.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check:cdn": "node ./scripts/check-cdn-paths.mjs",
    "build:vendor": "node ./scripts/build-admin-vendor.mjs",
    "check:vendor": "node ./scripts/build-admin-vendor.mjs --check"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  }
}
